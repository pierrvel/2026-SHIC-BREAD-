{
  "name": "school-bread-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:public": "vite --mode camera --host 0.0.0.0",
    "build": "vite build",
    "build:public": "node scripts/build-public.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:rules": "node --test tests/database.rules.test.js",
    "build:preview": "vite build --config vite.preview.config.js && node scripts/export-preview.mjs"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
