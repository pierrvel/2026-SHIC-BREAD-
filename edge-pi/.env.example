# Export these in your shell or service configuration. main.py does not auto-load .env.
MOCK_MODE=true
CAPTURE_INTERVAL=30
DIFF_THRESHOLD=2.0
# Live only. Keep the credential file OUTSIDE the repository and web root.
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.asia-southeast1.firebasedatabase.app
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json
EMPTY_IMAGE_PATH=/secure/path/empty-machine.jpg
CAMERA_BACKEND=auto
CAMERA_INDEX=0
